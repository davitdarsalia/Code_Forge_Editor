{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gitignore",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "comment"
          },
          {
            "type": "SYMBOL",
            "name": "pattern"
          },
          {
            "type": "PATTERN",
            "value": "\\r?\\n"
          }
        ]
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "#[^\\n]*"
        }
      }
    },
    "pattern": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "negation"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "REPEAT1",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "text"
                },
                {
                  "type": "SYMBOL",
                  "name": "separator"
                },
                {
                  "type": "SYMBOL",
                  "name": "wildcard"
                },
                {
                  "type": "SYMBOL",
                  "name": "bracket"
                },
                {
                  "type": "SYMBOL",
                  "name": "escape"
                }
              ]
            }
          }
        ]
      }
    },
    "negation": {
      "type": "STRING",
      "value": "!"
    },
    "text": {
      "type": "PATTERN",
      "value": "[^\\n\\/*?\\[\\\\]+"
    },
    "separator": {
      "type": "STRING",
      "value": "/"
    },
    "wildcard": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "*"
        },
        {
          "type": "STRING",
          "value": "**"
        },
        {
          "type": "STRING",
          "value": "?"
        }
      ]
    },
    "bracket": {
      "type": "PATTERN",
      "value": "\\[[^\\]\\n]*\\]"
    },
    "escape": {
      "type": "PATTERN",
      "value": "\\\\."
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}